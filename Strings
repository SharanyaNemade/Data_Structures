Question: Reverse a string without using Array.Reverse()


1. Reverse a String


using System;

class Program
{
    static void Main()
    {
        string input = "developer";

        char[] reversed = new char[input.Length];

        int index = 0;

        for (int i = input.Length - 1; i >= 0; i--)
        {
            reversed[index] = input[i];
            index++;
        }

        Console.Write("Reversed string: ");

        for (int i = 0; i < reversed.Length; i++)
        {
            Console.Write(reversed[i]);
        }

        Console.WriteLine();
    }
}



2. Check Whether a String Is a Palindrome




using System;

class Program
{
    static void Main()
    {
        string input = "madam";

        int left = 0;
        int right = input.Length - 1;

        bool isPalindrome = true;

        while (left < right)
        {
            if (input[left] != input[right])
            {
                isPalindrome = false;
                break;
            }

            left++;
            right--;
        }

        if (isPalindrome)
        {
            Console.WriteLine("String is a palindrome.");
        }
        else
        {
            Console.WriteLine("String is not a palindrome.");
        }
    }
}





3. Count Vowels, Consonants, Digits, and Spaces




using System;

class Program
{
    static void Main()
    {
        string input = "DotNet 123";

        int vowels = 0;
        int consonants = 0;
        int digits = 0;
        int spaces = 0;

        for (int i = 0; i < input.Length; i++)
        {
            char ch = input[i];

            // Convert uppercase English letters to lowercase
            if (ch >= 'A' && ch <= 'Z')
            {
                ch = (char)(ch + 32);
            }

            if (ch >= 'a' && ch <= 'z')
            {
                if (ch == 'a' || ch == 'e' ||
                    ch == 'i' || ch == 'o' || ch == 'u')
                {
                    vowels++;
                }
                else
                {
                    consonants++;
                }
            }
            else if (ch >= '0' && ch <= '9')
            {
                digits++;
            }
            else if (ch == ' ')
            {
                spaces++;
            }
        }

        Console.WriteLine("Vowels: " + vowels);
        Console.WriteLine("Consonants: " + consonants);
        Console.WriteLine("Digits: " + digits);
        Console.WriteLine("Spaces: " + spaces);
    }
}





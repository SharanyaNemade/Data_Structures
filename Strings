8. Reverse the Words in a Sentence


Question: Reverse the order of words without reversing the characters within each word.

Example: I love CSharp → CSharp love I



using System;

class Program
{
    static void Main()
    {
        string input = "I love CSharp";

        char[] characters = new char[input.Length];

        // Copy string into character array
        for (int i = 0; i < input.Length; i++)
        {
            characters[i] = input[i];
        }

        // Reverse the complete character array
        ReverseRange(characters, 0, characters.Length - 1);

        int start = 0;

        // Reverse each individual word
        for (int i = 0; i <= characters.Length; i++)
        {
            if (i == characters.Length || characters[i] == ' ')
            {
                ReverseRange(characters, start, i - 1);

                start = i + 1;
            }
        }

        Console.Write("Reversed words: ");

        for (int i = 0; i < characters.Length; i++)
        {
            Console.Write(characters[i]);
        }

        Console.WriteLine();
    }

    static void ReverseRange(char[] characters, int left, int right)
    {
        while (left < right)
        {
            char temp = characters[left];
            characters[left] = characters[right];
            characters[right] = temp;

            left++;
            right--;
        }
    }
}




9. Find the Longest Word in a Sentence
Question: Find the longest word without using Split().

Example: I am learning ASP.NET Core



using System;

class Program
{
    static void Main()
    {
        string sentence = "I am learning ASP.NET Core";

        int currentStart = 0;

        int longestStart = 0;
        int longestLength = 0;

        for (int i = 0; i <= sentence.Length; i++)
        {
            if (i == sentence.Length || sentence[i] == ' ')
            {
                int currentLength = i - currentStart;

                if (currentLength > longestLength)
                {
                    longestLength = currentLength;
                    longestStart = currentStart;
                }

                currentStart = i + 1;
            }
        }

        if (longestLength == 0)
        {
            Console.WriteLine("No word found.");
        }
        else
        {
            Console.Write("Longest word: ");

            for (int i = longestStart;
                 i < longestStart + longestLength;
                 i++)
            {
                Console.Write(sentence[i]);
            }

            Console.WriteLine();

            Console.WriteLine("Length: " + longestLength);
        }
    }
}



10. Compress a String Using Character Counts
Question: Convert consecutive repeated characters into a character followed by its count.

Example: aaabbccccd → a3b2c4d1



using System;

class Program
{
    static void Main()
    {
        string input = "aaabbccccd";

        char[] result = new char[input.Length * 2];

        int i = 0;
        int resultIndex = 0;

        while (i < input.Length)
        {
            char current = input[i];

            int count = 0;

            // Count consecutive occurrences
            while (i < input.Length && input[i] == current)
            {
                count++;
                i++;
            }

            // Store the character
            result[resultIndex] = current;
            resultIndex++;

            // Store the digits of count in reverse order
            int tempCount = count;
            int digitStart = resultIndex;

            do
            {
                result[resultIndex] = (char)('0' + tempCount % 10);
                resultIndex++;

                tempCount = tempCount / 10;
            }
            while (tempCount > 0);

            // Reverse the stored count digits
            int left = digitStart;
            int right = resultIndex - 1;

            while (left < right)
            {
                char temp = result[left];
                result[left] = result[right];
                result[right] = temp;

                left++;
                right--;
            }
        }

        Console.Write("Compressed string: ");

        for (int j = 0; j < resultIndex; j++)
        {
            Console.Write(result[j]);
        }

        Console.WriteLine();
    }
}





11. Find the Longest Substring Without Repeating Characters
Question: Find the longest continuous substring in which no character repeats.

Example: abcabcbb → abc, length 3.



using System;

class Program
{
    static void Main()
    {
        string input = "abcabcbb";

        // Store the last index at which each character appeared
        int[] lastSeen = new int[65536];

        for (int i = 0; i < lastSeen.Length; i++)
        {
            lastSeen[i] = -1;
        }

        int left = 0;

        int bestStart = 0;
        int bestLength = 0;

        for (int right = 0; right < input.Length; right++)
        {
            char current = input[right];

            // If the character repeats inside the current window,
            // move the left boundary past its previous occurrence.
            if (lastSeen[current] >= left)
            {
                left = lastSeen[current] + 1;
            }

            lastSeen[current] = right;

            int currentLength = right - left + 1;

            if (currentLength > bestLength)
            {
                bestLength = currentLength;
                bestStart = left;
            }
        }

        Console.Write("Longest substring: ");

        for (int i = bestStart; i < bestStart + bestLength; i++)
        {
            Console.Write(input[i]);
        }

        Console.WriteLine();
        Console.WriteLine("Length: " + bestLength);
    }
}




12. Find the Longest Palindromic Substring
Question: Find the longest continuous substring that is a palindrome.

Example: babad → bab (or aba).




using System;

class Program
{
    static void Main()
    {
        string input = "babad";

        char[] characters = new char[input.Length];

        for (int i = 0; i < input.Length; i++)
        {
            characters[i] = input[i];
        }

        int bestStart = 0;
        int bestLength = 0;

        for (int center = 0; center < characters.Length; center++)
        {
            // Odd-length palindrome, such as "bab"
            ExpandAroundCenter(
                characters, center, center,
                ref bestStart, ref bestLength);

            // Even-length palindrome, such as "abba"
            ExpandAroundCenter(
                characters, center, center + 1,
                ref bestStart, ref bestLength);
        }

        Console.Write("Longest palindrome: ");

        for (int i = bestStart; i < bestStart + bestLength; i++)
        {
            Console.Write(characters[i]);
        }

        Console.WriteLine();
        Console.WriteLine("Length: " + bestLength);
    }

    static void ExpandAroundCenter(
        char[] characters,
        int left,
        int right,
        ref int bestStart,
        ref int bestLength)
    {
        while (left >= 0 &&
               right < characters.Length &&
               characters[left] == characters[right])
        {
            int currentLength = right - left + 1;

            if (currentLength > bestLength)
            {
                bestStart = left;
                bestLength = currentLength;
            }

            left--;
            right++;
        }
    }
}





13. Convert a String to an Integer Without int.Parse()
Question: Implement basic string-to-integer conversion, including leading spaces, an optional sign, and overflow handling.

Example: "   -12345abc" → -12345




using System;

class Program
{
    static void Main()
    {
        string input = "   -12345abc";

        int index = 0;

        // Skip leading whitespace
        while (index < input.Length &&
               (input[index] == ' ' ||
                input[index] == '\t' ||
                input[index] == '\n' ||
                input[index] == '\r'))
        {
            index++;
        }

        // Read the optional sign
        bool isNegative = false;

        if (index < input.Length &&
            (input[index] == '-' || input[index] == '+'))
        {
            if (input[index] == '-')
            {
                isNegative = true;
            }

            index++;
        }

        long number = 0;

        // Use limits that account for the sign
        long limit = isNegative ? 2147483648L : 2147483647L;

        // Read digits until a non-digit is encountered
        while (index < input.Length)
        {
            char ch = input[index];

            if (ch < '0' || ch > '9')
            {
                break;
            }

            int digit = ch - '0';

            // Check overflow before multiplying by 10
            if (number > (limit - digit) / 10)
            {
                number = limit;
                break;
            }

            number = number * 10 + digit;

            index++;
        }

        long result = isNegative ? -number : number;

        // Clamp the result to the 32-bit integer range
        if (result > 2147483647L)
        {
            result = 2147483647L;
        }

        if (result < -2147483648L)
        {
            result = -2147483648L;
        }

        Console.WriteLine("Integer value: " + (int)result);
    }
}



14. Check for Balanced Parentheses, Brackets, and Braces
Question: Determine whether brackets are correctly opened, closed, and nested.

Example: {[()]} → balanced.




using System;

class Program
{
    static void Main()
    {
        string input = "{[()]}";

        // Array-based stack
        char[] stack = new char[input.Length];

        int top = -1;

        bool isBalanced = true;

        for (int i = 0; i < input.Length; i++)
        {
            char ch = input[i];

            // Push opening brackets
            if (ch == '(' || ch == '[' || ch == '{')
            {
                top++;
                stack[top] = ch;
            }
            // Process closing brackets
            else if (ch == ')' || ch == ']' || ch == '}')
            {
                // No opening bracket available
                if (top == -1)
                {
                    isBalanced = false;
                    break;
                }

                char opening = stack[top];
                top--;

                // Check whether the bracket types match
                if ((ch == ')' && opening != '(') ||
                    (ch == ']' && opening != '[') ||
                    (ch == '}' && opening != '{'))
                {
                    isBalanced = false;
                    break;
                }
            }
        }

        // Any remaining opening bracket is unmatched
        if (top != -1)
        {
            isBalanced = false;
        }

        if (isBalanced)
        {
            Console.WriteLine("Brackets are balanced.");
        }
        else
        {
            Console.WriteLine("Brackets are not balanced.");
        }
    }
}



Logic: Push every opening bracket onto a stack. For each closing bracket, check whether it matches the most recent opening bracket. At the end, the stack must be empty.

Complexity: Time O(n), space O(n).

Interview follow-up: Explain why a stack is needed. For example, ([)] is invalid even though its counts of opening and closing brackets match.
